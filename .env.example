APP_BASE_URL=http://localhost:8080
DATABASE_URL=sqlite:///.data/kontroferta.db
FILE_STORAGE_PATH=.data/files
AI_MODEL=gemini-3.8-flash
AI_THINKING_LEVEL=low
# Interactions store=false is enforced in code.
OIDC_ISSUER=http://localhost:8081
OIDC_CLIENT_ID=kontroferta-local
# OIDC callback is derived from APP_BASE_URL + /api/auth/callback.
SESSION_HOURS=12
# Inject secret values with psst, never save them here.
# GOOGLE_AI_STUDIO_API_KEY
# KONTROFERTA_SESSION_SECRET
# OIDC_CLIENT_SECRET (confidential external OIDC clients only)
# Each case stores its own IANA timezone, chosen in the requirements form.
OCR_LANGUAGES=pol+eng
MAX_UPLOAD_MB=20
MAX_DOCUMENT_PAGES=100
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2
AI_MAX_CONCURRENCY=2
AI_MAX_INPUT_TOKENS_PER_CASE=100000
AI_MAX_OUTPUT_TOKENS=16384
MAX_SCENARIOS=100000
CASE_BUDGET_USD=1
DAILY_BUDGET_USD=20
ACCOUNT_DAILY_BUDGET_USD=5
CASE_RETENTION_DAYS=90
DEMO_RETENTION_HOURS=24
BACKUP_RETENTION_DAYS=7
BACKUP_PATH=.data/backups
MAINTENANCE_INTERVAL_SECONDS=3600
AI_INPUT_USD_PER_MILLION=0.75
AI_OUTPUT_USD_PER_MILLION=3.75
AI_PRICE_DATE=2026-10-03
AI_PRICE_SOURCE=https://ai.google.dev/gemini-api/docs/pricing
