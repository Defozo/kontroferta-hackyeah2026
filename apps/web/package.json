{
  "name": "kontroferta-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run contracts:check && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit",
    "contracts:generate": "openapi-typescript ../../packages/contracts/openapi.json -o src/generated-api.d.ts",
    "contracts:check": "openapi-typescript ../../packages/contracts/openapi.json -o src/generated-api.d.ts --check",
    "test": "node --experimental-strip-types --test tests/pure.test.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-tabs": "1.1.13",
    "@tanstack/react-query": "5.90.21",
    "lucide-react": "0.577.0",
    "pdfjs-dist": "5.4.624",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "7.71.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "axe-core": "4.11.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
